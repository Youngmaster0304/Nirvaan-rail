# ============================================================================
# SIH26027 / A-ABPS — Environment Configuration
# Copy this file to .env and update values. Every entry has a working default,
# so an empty .env is enough for local development.
# ============================================================================

# --- Backend -----------------------------------------------------------------
# MUST use the +aiosqlite dialect: app/database.py calls create_async_engine(),
# and the sync sqlite:/// driver raises at startup.
DATABASE_URL=sqlite+aiosqlite:///./block_planning.db

# Generate a long random value before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated origins allowed to call the API with credentials.
# Local dev:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# After deploying the frontend, append its origin, e.g.:
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# --- Government open data (optional) -----------------------------------------
# Free key for data.gov.in (Open Government Data, India):
#   1) Open https://www.data.gov.in/login and Register (or sign in)
#   2) Go to Dashboard -> "Generate API key" and copy the 64-character key
#   3) Test: https://api.data.gov.in/resource/<RESOURCE_ID>?api-key=$DATA_GOV_IN_API_KEY&format=json&limit=1
# Leave blank to serve the bundled fallback dataset (no network required).
# Note: data.gov.in currently returns 502 for many resources; the endpoint
# falls back automatically and reports the reason in its "note" field.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_IDS=

# --- Chatbot LLM (optional) ---------------------------------------------------
# The chatbot answers from the live database with no key configured.
# Setting either key upgrades free-text answers to LLM-written ones.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# --- Frontend (Vite) ----------------------------------------------------------
# Absolute backend origin for deployed builds. Leave EMPTY for local dev and
# Docker — both proxy /api to the backend, so no origin is needed.
# Vercel: set this in Project Settings -> Environment Variables.
# VITE_API_URL=

# --- Docker -------------------------------------------------------------------
COMPOSE_PROJECT_NAME=sih26027
